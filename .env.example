# PersonaOS environment variables.
# Copy to .env (never commit .env). Secrets are left blank; fill them locally.
# Non-secret values below are the recommended local defaults.

# --- App ---
# dev | test | production
APP_ENV=dev
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# json | text
LOG_FORMAT=text

# --- Postgres (used by docker-compose) ---
POSTGRES_USER=personaos
# REQUIRED for docker compose. Any strong local password.
POSTGRES_PASSWORD=
POSTGRES_DB=personaos
# Host port for Postgres (change if 5432 is already in use on your machine)
POSTGRES_HOST_PORT=5432
# Optional full override. If blank, the app builds it from POSTGRES_* above
# (host = POSTGRES_HOST, default 127.0.0.1; inside Docker compose sets it to "postgres").
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL=

# --- LLM (chat/agent) --- gemini | ollama | openai | fake
LLM_PROVIDER=gemini
# Model name is confirmed in Phase 3 (a Gemini Flash model on the free tier)
LLM_MODEL=
# Google AI Studio key (Phase 3)
GEMINI_API_KEY=
# Optional, only if LLM_PROVIDER=openai (or an OpenAI-compatible server)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- Embeddings --- ollama | gemini | openai | fake
# Changing the embedding model later requires re-embedding all stored vectors.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
# Host Ollama. Inside Docker, compose overrides this to http://host.docker.internal:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Auth --- firebase | fake (fake is only allowed when APP_ENV is dev/test)
AUTH_PROVIDER=firebase
# Firebase console > Project settings > General > Project ID
FIREBASE_PROJECT_ID=
# Web app "apiKey" from the Firebase web config. Used only by scripts/get_id_token.py
# (and later the Streamlit login). Not a secret, but keep it out of Git anyway.
FIREBASE_WEB_API_KEY=

# --- Tests ---
# Optional. Postgres URL for the test suite. If blank, tests use the POSTGRES_* values above
# with database "personaos_test" on localhost (created automatically).
TEST_DATABASE_URL=

# --- Storage ---
# Inside Docker, compose overrides this to /data/chroma (a named volume)
CHROMA_PATH=./chroma_data
MAX_UPLOAD_MB=10

# --- Web ---
FRONTEND_ORIGIN=http://localhost:8501

# --- Optional integrations (the app starts without them) ---
# Phase 7: shared secret for the memory-lifecycle cron endpoint
CRON_SECRET=
# Phase 8: Fernet key for encrypting Google refresh tokens
TOKEN_ENCRYPTION_KEY=
# Phase 8: Google OAuth client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/integrations/google/callback
